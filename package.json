{
  "name": "@graphnous/typescript-scanner",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc && esbuild dist/main.js --bundle --platform=node --outfile=build/scanner.js",
    "start": "node dist/main.js",
    "generate": "curl -fsSL https://graphnous.github.io/graphnous-schemas/schema/scan/scan-result.schema.json | json2ts -o src/generated/ScanResult.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "typescript-api": "npm:typescript@^5.9.3"
  }
}
